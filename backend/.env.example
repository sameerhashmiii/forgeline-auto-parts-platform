# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auto_parts_platform?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long"
JWT_REFRESH_EXPIRES_IN="30d"

# Frontend
FRONTEND_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3001

# Stripe (optional)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."

# SendGrid (optional)
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="Auto Parts Platform"

# OpenAI (optional)
OPENAI_API_KEY="sk-..."

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# AWS S3 (optional)
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_REGION="us-east-1"
AWS_S3_BUCKET="auto-parts-platform-uploads"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100